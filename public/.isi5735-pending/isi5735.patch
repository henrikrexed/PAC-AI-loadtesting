+name: release
+
+# Build and publish the workload-model engine on every version tag:
+#   - standalone binaries for linux / macOS / windows (PyInstaller, one per OS/arch)
+#   - a multi-arch Docker image pushed to GHCR
+#   - a GitHub Release with all binaries attached
+#
+# Trigger: push a tag like `v0.1.0`, or run manually (workflow_dispatch) to smoke-test
+# the build without publishing a release.
+
+on:
+  push:
+    tags:
+      - "v*"
+  workflow_dispatch:
+
+permissions:
+  contents: write   # create the GitHub Release and upload binary assets
+  packages: write   # push the image to GHCR
+
+env:
+  BINARY_NAME: workload-engine
+  IMAGE: ghcr.io/henrikrexed/ai-performance-testing
+
+jobs:
+  # ---------------------------------------------------------------------------
+  # 1. Cross-platform binaries (PyInstaller must run on each target OS).
+  # ---------------------------------------------------------------------------
+  binaries:
+    name: binary (${{ matrix.target }})
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-latest
+            target: linux-amd64
+            data_sep: ":"
+          - os: ubuntu-24.04-arm
+            target: linux-arm64
+            data_sep: ":"
+          - os: macos-13
+            target: darwin-amd64
+            data_sep: ":"
+          - os: macos-latest
+            target: darwin-arm64
+            data_sep: ":"
+          - os: windows-latest
+            target: windows-amd64
+            data_sep: ";"
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install build deps
+        run: python -m pip install --upgrade pip pyinstaller "jsonschema>=4,<5"
+
+      - name: Build onefile binary
+        shell: bash
+        run: |
+          python -m PyInstaller --noconfirm --onefile --clean \
+            --name "$BINARY_NAME" \
+            --paths engine \
+            --add-data "engine/schema.json${{ matrix.data_sep }}." \
+            --hidden-import shaping --hidden-import archetypes \
+            --hidden-import clustering --hidden-import emit --hidden-import g0_gate \
+            engine/cli.py
+
+      - name: Smoke test the binary
+        shell: bash
+        run: |
+          BIN="dist/$BINARY_NAME"
+          [ "${{ matrix.target }}" = "windows-amd64" ] && BIN="dist/$BINARY_NAME.exe"
+          "$BIN" --extract examples/crewai-deepseek-agent/extract.json --out out_smoke
+          test -f out_smoke/workload-model.json
+
+      - name: Stage release asset
+        shell: bash
+        run: |
+          mkdir -p staged
+          if [ "${{ matrix.target }}" = "windows-amd64" ]; then
+            cp "dist/$BINARY_NAME.exe" "staged/${BINARY_NAME}-${{ matrix.target }}.exe"
+          else
+            cp "dist/$BINARY_NAME" "staged/${BINARY_NAME}-${{ matrix.target }}"
+          fi
+
+      - name: Upload build artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ env.BINARY_NAME }}-${{ matrix.target }}
+          path: staged/*
+          if-no-files-found: error
+
+  # ---------------------------------------------------------------------------
+  # 2. Multi-arch Docker image -> GHCR.
+  # ---------------------------------------------------------------------------
+  docker:
+    name: docker image (GHCR)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: docker/setup-qemu-action@v3
+      - uses: docker/setup-buildx-action@v3
+
+      - name: Log in to GHCR
+        uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Image metadata
+        id: meta
+        uses: docker/metadata-action@v5
+        with:
+          images: ${{ env.IMAGE }}
+          tags: |
+            type=semver,pattern={{version}}
+            type=semver,pattern={{major}}.{{minor}}
+            type=raw,value=latest,enable=${{ startsWith(github.ref, 'refs/tags/v') }}
+
+      - name: Build and push
+        uses: docker/build-push-action@v6
+        with:
+          context: .
+          platforms: linux/amd64,linux/arm64
+          push: ${{ startsWith(github.ref, 'refs/tags/v') }}
+          tags: ${{ steps.meta.outputs.tags }}
+          labels: ${{ steps.meta.outputs.labels }}
+          provenance: false
+
+  # ---------------------------------------------------------------------------
+  # 3. Publish the GitHub Release with all binaries attached.
+  #    Runs only for tag pushes, after binaries + image succeed.
+  # ---------------------------------------------------------------------------
+  release:
+    name: github release
+    needs: [binaries, docker]
+    if: startsWith(github.ref, 'refs/tags/v')
+    runs-on: ubuntu-latest
+    steps:
+      - name: Download all binaries
+        uses: actions/download-artifact@v4
+        with:
+          path: dist
+          merge-multiple: true
+
+      - name: List assets
+        run: ls -la dist
+
+      - name: Create release and attach binaries
+        uses: softprops/action-gh-release@v2
+        with:
+          files: dist/*
+          generate_release_notes: true
+          body: |
+            ## AI-Performance-Testing — workload-model engine ${{ github.ref_name }}
+
+            Standalone builds of the SCOPE-stage engine (`python -m engine.cli`).
+
+            **Binaries** (attached below): `linux-amd64`, `linux-arm64`, `darwin-amd64`,
+            `darwin-arm64`, `windows-amd64`.
+
+            **Docker image:** `docker pull ${{ env.IMAGE }}:${{ github.ref_name }}` (multi-arch: amd64 + arm64).
+
+            Install and usage: see [`docs/engine.md`](https://github.com/henrikrexed/AI-Performance-Testing/blob/main/docs/engine.md).
