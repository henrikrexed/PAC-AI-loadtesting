+# syntax=docker/dockerfile:1
+# -----------------------------------------------------------------------------
+# AI-Performance-Testing — workload-model engine (SCOPE stage)
+#
+# A minimal, multi-arch image wrapping `python -m engine.cli`. The engine is
+# backend- and tool-agnostic: it turns a neutral telemetry extract (JSON) into a
+# G0-gated workload-model.json + scenario-proposal.md. It never talks to a
+# backend or a load tool.
+#
+# Build (multi-arch):
+#   docker buildx build --platform linux/amd64,linux/arm64 \
+#     -t ghcr.io/henrikrexed/ai-performance-testing:latest --push .
+#
+# Run:
+#   docker run --rm -v "$PWD":/work ghcr.io/henrikrexed/ai-performance-testing:latest \
+#     --extract /work/extract.json --out /work/out
+# -----------------------------------------------------------------------------
+FROM python:3.12-slim
+
+LABEL org.opencontainers.image.title="AI-Performance-Testing workload-model engine" \
+      org.opencontainers.image.description="Observability-driven workload modeling (SCOPE stage): neutral telemetry extract -> G0-gated workload-model.json + scenario-proposal.md" \
+      org.opencontainers.image.source="https://github.com/henrikrexed/AI-Performance-Testing" \
+      org.opencontainers.image.licenses="Apache-2.0" \
+      org.opencontainers.image.vendor="IsItObservable / Henrik Rexed"
+
+# jsonschema is the engine's only runtime dependency (G0 schema validation).
+RUN pip install --no-cache-dir "jsonschema>=4,<5"
+
+WORKDIR /app
+COPY engine/ ./engine/
+# Keep the `engine` package importable no matter the working directory.
+ENV PYTHONPATH=/app
+
+# Run as a non-root user; /work is the conventional I/O mount point.
+RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin engine \
+    && mkdir /work && chown engine:engine /work
+USER engine
+WORKDIR /work
+
+ENTRYPOINT ["python", "-m", "engine.cli"]
+CMD ["--help"]
