{
  "apiVersion": "loadtest.isi/v1alpha1",
  "kind": "WorkloadModel",
  "metadata": {
    "name": "checkout",
    "targetService": "frontend-proxy",
    "environment": "staging-dt-tenant",
    "source": { "tool": "dtctl", "timeframe": "2026-10-01T00:00Z/2026-10-08T00:00Z" }
  },
  "spec": {
    "arrivalProfile": {
      "model": "open",
      "stages": [
        { "duration": "5m", "rate": 50, "shape": "ramp_up" },
        { "duration": "20m", "rate": 200, "shape": "plateau" },
        { "duration": "5m", "rate": 0, "shape": "ramp_down" }
      ],
      "littlesLawCheck": { "expectedConcurrency": 40, "observedConcurrency": 44, "ratio": 1.1 }
    },
    "journeys": [
      {
        "id": "browse",
        "weight": 0.8,
        "entrypoint": "GET /api/products",
        "steps": [
          { "id": "list", "service": "product-catalog", "operation": "GET /api/products", "callType": "http" }
        ],
        "baseline": { "p50Ms": 40, "p95Ms": 180, "p99Ms": 450, "errorRate": 0.001 }
      },
      {
        "id": "checkout",
        "weight": 0.2,
        "entrypoint": "POST /api/cart/checkout",
        "steps": [
          { "id": "addToCart", "service": "cart", "operation": "POST /api/cart", "callType": "http" },
          {
            "id": "pay", "service": "checkout", "operation": "POST /api/cart/checkout", "callType": "http",
            "dependsOn": ["addToCart"],
            "correlates": [
              { "sourceStepId": "addToCart",
                "extract": { "from": "body_json", "path": "$.cartId" },
                "inject": { "into": "body_field", "as": "cartId" } }
            ]
          }
        ],
        "baseline": { "p50Ms": 120, "p95Ms": 600, "p99Ms": 1500, "errorRate": 0.005 }
      }
    ],
    "caps": { "maxRps": 400, "maxVus": 200, "maxDuration": "30m" },
    "coverage": 0.86
  },
  "status": {
    "revision": 3,
    "hash": "sha256:deadbeef",
    "approval": {
      "revision": 3,
      "decision": "approved",
      "decisionBy": "henrik@perfbytes.com",
      "decisionAt": "2026-10-09T09:00:00Z",
      "confirmationRef": "confirmation:example:plan:00000000"
    }
  }
}
