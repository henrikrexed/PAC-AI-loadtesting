# ---------------------------------------------------------------------------
# AI-Performance-Testing toolkit — environment configuration
# Copy to `.env`, fill in your own values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# --- Observability backend (Dynatrace Grail) --------------------------------
# Used by: skills/workload-model (DQL extraction), skills/baseline-diff (baseline
# comparison), utilities/rum_sessions.py + session_stitch.py (via your DQL client).
# Example: https://your-environment.live.dynatrace.com
DT_ENDPOINT=

# Read-only API token. Minimum scopes:
#   storage:spans:read, storage:logs:read            (workload-model, baseline-diff)
#   storage:user.events:read                          (RUM ordered actions; optional)
#   storage:user.sessions:read is usually covered by a plain read token
DT_API_TOKEN=

# Default extraction window (DQL time selector syntax), e.g. -3h / -24h / 2026-01-01T00:00:00Z/24h
DT_TIMEFRAME=-3h

# --- System under test -------------------------------------------------------
# Entry-point URL of the application under test (consumed by generated k6 scripts
# as __ENV.BASE_URL; also the allowlist basis for loadtest-run).
BASE_URL=http://localhost:8080

# --- Tooling -----------------------------------------------------------------
# k6 binary (optional; skills fall back to `node --check` when absent)
K6_BINARY=k6

# Output override for the workload-model worked example (optional)
# WORKLOAD_OUT=./out/my-example

# --- Tutorial demo component (tutorial/component) ----------------------------
# Ship telemetry to YOUR Dynatrace environment via the component's collector.
# DT_OTLP_ENDPOINT is the OTLP ingest URL; DT_OTLP_API_TOKEN is a SEPARATE ingest
# token (scope: ingestion:otlp:write) — not the read-only DT_API_TOKEN above.
# Example: https://your-environment.live.dynatrace.com/api/v2/otlp
DT_OTLP_ENDPOINT=
DT_OTLP_API_TOKEN=

# Demo agent app (https://platform.deepseek.com) — your own key; the tutorial
# window costs cents.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Baseline traffic driver defaults (tutorial/component/loadgen/driver.js).
# Can also be passed inline to k6; values here are the intended defaults.
RATE_PER_MIN=20
DURATION=45m
TOOL_RATIO=0.30
PRE_ALLOC=20
